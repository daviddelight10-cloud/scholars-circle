{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/icon-(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/resources/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|[Tt]elegram|facebookexternalhit|Facebot|[Tt]witterbot|[Ss]lackbot|[Dd]iscordbot|[Ll]inkedIn[Bb]ot|[Gg]ooglebot|bingbot|Applebot|[Pp]interest|redditbot|Embedly|SkypeUriPreview|vkShare).*"
        }
      ],
      "destination": "https://scholars-circle-production.up.railway.app/og/resource/:token"
    },
    {
      "source": "/folders/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ww]hats[Aa]pp|[Tt]elegram|facebookexternalhit|Facebot|[Tt]witterbot|[Ss]lackbot|[Dd]iscordbot|[Ll]inkedIn[Bb]ot|[Gg]ooglebot|bingbot|Applebot|[Pp]interest|redditbot|Embedly|SkypeUriPreview|vkShare).*"
        }
      ],
      "destination": "https://scholars-circle-production.up.railway.app/og/folder/:token"
    },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }
  ]
}
